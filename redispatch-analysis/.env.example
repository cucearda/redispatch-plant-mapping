# Copy to .env. Every value is optional — the defaults resolve relative to the
# repository root.

# --- LLM pipeline -----------------------------------------------------
CLAUDE_API_KEY=sk-ant-...

# --- rule-based matcher + maps ----------------------------------------
# Raw netztransparenz redispatch exports (note the differing encodings —
# see data/README_sources.md)
REDISPATCH_2013_2020=data/Redispatch_Daten_2013_2020.csv
REDISPATCH_2021_ON=data/Redispatch_Daten_2021_2026.csv

# Registries
OPSD_CSV=data/conventional_power_plants_DE.csv
PSA_CSV=data/powerplantsPSA.csv

# PyPSA network export (buses.csv / lines.csv / links.csv) used by the maps
GRID_DATA_DIR=data/grid_data

# Where the rule-based matcher writes results, maps and figures
MATCHER_OUT_DIR=results/matcher
MAPS_OUT_DIR=results/maps
FIGURES_OUT=figures/maps

# Headless browser used by maps/render_to_png.py
# CHROME_BINARY=/usr/bin/google-chrome
